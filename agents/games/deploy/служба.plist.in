<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@ИМЯ@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@UV@</string><string>run</string><string>--project</string><string>@КОД@</string>
    <string>python</string><string>@КОД@/@ПРОГРАММА@</string>
@ДОВОДЫ@  </array>
  <key>WorkingDirectory</key><string>@КОД@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@ПУТЬ@</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>@ЖУРНАЛЫ@/@КОРОТКО@.log</string>
  <key>StandardErrorPath</key><string>@ЖУРНАЛЫ@/@КОРОТКО@.log</string>
@РАСПИСАНИЕ@</dict>
</plist>
