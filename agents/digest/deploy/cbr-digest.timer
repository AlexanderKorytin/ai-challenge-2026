# Расписание агента сводок. Для показа — каждые 10 минут; для работы — раз в день после
# публикации курса ЦБ (около 15:30 по Москве), например OnCalendar=*-*-* 16:00 Europe/Moscow.
# Persistent=true: пропущенный за время простоя срок выполняется один раз при подъёме.
[Unit]
Description=Агент сводок по курсам ЦБ — расписание

[Timer]
OnCalendar=*:0/10
Persistent=true

[Install]
WantedBy=timers.target
